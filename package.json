{
  "name": "video-splicer",
  "version": "1.0.0",
  "private": true,
  "description": "Laptop IP control plane for NovaStar MCTRL4K and compatible LED controllers",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"node server/index.js\" \"vite --config web/vite.config.js\"",
    "start": "NODE_ENV=production node server/index.js",
    "build": "vite build --config web/vite.config.js",
    "test": "node --test test/*.test.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.1.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.3.5"
  }
}
